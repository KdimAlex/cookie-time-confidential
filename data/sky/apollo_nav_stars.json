{
  "catalog": "Apollo guide stars",
  "count": 37,
  "source": {
    "vectors": "Colossus 249 STAR_TABLES.agc, assembled 28 October 1968. Public domain. Virtual AGC transcription.",
    "vectors_url": "https://github.com/virtualagc/virtualagc/blob/master/Colossus249/STAR_TABLES.agc",
    "names_and_magnitudes": "Luminary 209 reference card, stab/planet list dated 1 January 1971. GE Apollo Systems, Houston.",
    "names_url": "https://www.ibiblio.org/apollo/Documents/islgc_reference_cards_lmy209.pdf",
    "frame": "AGC basic reference: X toward the vernal equinox, Z toward the north celestial pole, Y completing a right-handed set. Comments in the source number the stars in decimal order 1 through 37; the octal field is that index printed in octal, which is the code the crew keyed.",
    "epoch_note": "These are the flight-computer components, not a J2000 catalog. Precession to a 2026 planetarium night is a separate step."
  },
  "memorial_names": {
    "who": "Anthony Jenzano, Morehead director, put three names onto the NASA list. Gus Grissom had coined them in 1966 from the Apollo 1 crew.",
    "stars": [
      "Navi",
      "Regor",
      "Dnoces"
    ]
  },
  "named_sightings": [
    {
      "mission": "Apollo 13",
      "stars": [
        "Altair",
        "Vega"
      ],
      "when": "After debris cleared, hours before reentry."
    },
    {
      "mission": "Apollo 13",
      "stars": [
        "Antares",
        "Nunki"
      ],
      "when": "Flying into the shadow of the Moon."
    }
  ],
  "missions_without_a_named_pair": [
    "Faith 7 (Mercury-Atlas 9): Gordon Cooper held a 34 degree reentry attitude by the stars. Sources do not name the pair.",
    "Apollo 12: after lightning, the crew realigned by sighting key stars. Sources used here do not name them."
  ],
